--========================================
-- SAVE / LOAD
--========================================

local SAVE_FILE = "DuyBaoKaitun_Data.json"

local function SaveData()
    if not (writefile and isfile) then
        return false
    end

    local success = pcall(function()
        writefile(
            SAVE_FILE,
            HttpService:JSONEncode(Data)
        )
    end)

    return success
end

local function LoadData()
    if not (readfile and isfile) then
        return
    end

    local success, result = pcall(function()
        if isfile(SAVE_FILE) then
            return HttpService:JSONDecode(
                readfile(SAVE_FILE)
            )
        end
    end)

    if success and type(result) == "table" then
        for name, value in pairs(result.Modules or {}) do
            if Data.Modules[name] ~= nil then
                Data.Modules[name] = value
            end
        end

        Data.Progress = result.Progress or Data.Progress
        Data.Logs = result.Logs or {}
    end
end

LoadData()

--========================================
-- PLAYER INFORMATION
--========================================

local function GetLevel()
    local data = Player:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")

    return level and level.Value or 0
end

local function GetSea()
    local place = game.PlaceId

    if place == 2753915549 then
        return "Sea 1"
    elseif place == 4442272183 then
        return "Sea 2"
    elseif place == 7449423635 then
        return "Sea 3"
    end

    return "Unknown"
end

local function HasItem(name)
    local backpack = Player:FindFirstChild("Backpack")
    local character = Player.Character

    return (
        (backpack and backpack:FindFirstChild(name))
        or
        (character and character:FindFirstChild(name))
    ) ~= nil
end

--========================================
-- LOG SYSTEM
--========================================

local function AddLog(message)
    table.insert(
        Data.Logs,
        1,
        os.date("%H:%M:%S") .. " | " .. message
    )

    while #Data.Logs > 50 do
        table.remove(Data.Logs)
    end

    SaveData()
end

--========================================
-- MODULE MANAGER
--========================================

local ModuleStatus = {}

local function RegisterModule(name, callback)
    ModuleStatus[name] = {
        Enabled = Data.Modules[name] == true,
        Callback = callback,
        Status = "Waiting"
    }
end

local function SetModule(name, enabled)
    if not ModuleStatus[name] then
        return
    end

    Data.Modules[name] = enabled
    ModuleStatus[name].Enabled = enabled

    ModuleStatus[name].Status =
        enabled and "Enabled - awaiting module"
        or "Disabled"

    AddLog(name .. (enabled and " enabled" or " disabled"))
end

-- Module placeholders: actual game automation is not connected.
for name in pairs(Data.Modules) do
    RegisterModule(name, function()
        return false, "Automation module not implemented"
    end)
end

