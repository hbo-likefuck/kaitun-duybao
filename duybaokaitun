end

local function AddLabel(text, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -5, 0, 30)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color or Color3.new(1, 1, 1)
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = Content
    return label
end

local function AddToggle(name)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 35)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 13
    button.Font = Enum.Font.Gotham
    button.Parent = Content

    local function Refresh()
        local enabled = Data.Modules[name]

        button.Text = name .. " : " ..
            (enabled and "ON" or "OFF")

        button.BackgroundColor3 = enabled
            and Color3.fromRGB(35, 105, 75)
            or Color3.fromRGB(55, 55, 68)
    end

    Refresh()

    button.Activated:Connect(function()
        SetModule(name, not Data.Modules[name])
        Refresh()
    end)
end

local function ShowDashboard()
    Clear()

    AddLabel("LIVE DASHBOARD",
        Color3.fromRGB(100, 190, 255))

    AddLabel("Sea: " .. GetSea())
    AddLabel("Level: " .. GetLevel())
    AddLabel("Last activity: " ..
        Data.Progress.LastActivity)

    AddLabel("WEAPON COLLECTION",
        Color3.fromRGB(100, 190, 255))

    local important = {
        "Yama",
        "Tushita",
        "Cursed Dual Katana",
        "Skull Guitar",
        "God Human"
    }

    for _, name in ipairs(important) do
        AddLabel(
            (HasItem(name) and "[OWNED] " or "[NOT DETECTED] ")
            .. name
        )
    end

    AddLabel("MODULE STATUS",
        Color3.fromRGB(100, 190, 255))

    for name, module in pairs(ModuleStatus) do
        AddLabel(name .. " : " .. module.Status)
    end
end

local function ShowModules(category)
    Clear()

    AddLabel(category,
        Color3.fromRGB(100, 190, 255))

    local groups = {
        Farm = {
            "AutoFarm",
            "AutoQuest",
            "AutoMastery",
            "AutoBoss",
            "AutoRaid"
        },

        Progress = {
            "AutoSeaProgress",
            "AutoCDK",
            "AutoSoulGuitar",
            "AutoGodHuman"
        },

        Fruits = {
            "AutoCollectFruit",
            "AutoRandomFruit",
            "AutoStoreFruit"
        },

        Server = {
            "AutoHopServer",
            "AutoRaceV4"
        }
    }

    for _, name in ipairs(groups[category] or {}) do
        AddToggle(name)
    end
end

local function ShowLogs()
    Clear()

    AddLabel("ACTIVITY LOG",
        Color3.fromRGB(100, 190, 255))

    if #Data.Logs == 0 then
        AddLabel("No activity recorded.")
    end

    for _, log in ipairs(Data.Logs) do
        AddLabel(log)
    end
end

